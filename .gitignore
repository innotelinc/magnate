# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.sample
!.env.example

# local database
/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cerulean Vault token copies (data/vault/token/<product>.token) — live
# credentials. `/data` above already covers them; spelled out so the reason
# survives a future narrowing of that rule.
data/vault/token/
data/vault/init/
data/vault/file/
