# Public URL of this site (used for Stripe success/cancel redirects)
APP_URL=http://localhost:3000

# --- Stripe ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint you create in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx
# ISO currency code for plan prices (defaults to usd)
STRIPE_CURRENCY=usd

# --- Jellyfin ---
# Your Jellyfin server (no trailing slash)
JELLYFIN_URL=https://media.innotel.us
# Create at Dashboard → Advanced → API Keys
JELLYFIN_API_KEY=your-jellyfin-api-key

# --- jfa-go account portal ---
JFA_GO_URL=https://accounts.innotel.us

# --- Admin panel ---
# Cerulean Authentik is the admin panel's identity provider (OIDC,
# authorization-code + PKCE). Set the three AUTHENTIK_* values below and the
# login page signs in with Cerulean; password sign-in is OFF by default.
AUTHENTIK_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/magnate-admin
AUTHENTIK_CLIENT_ID=magnate-admin
AUTHENTIK_CLIENT_SECRET=
# Comma-separated emails allowed to hold an admin session.
AUTHENTIK_ADMIN_EMAILS=
# Absolute callback URL registered on the Authentik application.
AUTHENTIK_REDIRECT_URI=https://admin.magnate.innotel.us/api/auth/authentik/callback
# Admin API (user provisioning, password resets, the paid_users group). Base is
# the Authentik origin — lib/authentik.ts appends /api/v3. Both must be set or
# `authentikConfigured()` is false and the Stripe webhook silently skips
# provisioning: AUTHENTIK_BOOTSTRAP_TOKEN is the shared instance token.
AUTHENTIK_BASE_URL=https://auth.magnate.innotel.us
AUTHENTIK_BOOTSTRAP_TOKEN=
# Break-glass only: re-enables the local ADMIN_PASSWORD form so an operator can
# get in while Authentik is unreachable. Set it, sign in, fix Authentik, unset
# it and restart. Leave empty in normal operation.
BREAKGLASS_LOGIN=
# Local fallback credential — used ONLY while BREAKGLASS_LOGIN is set.
ADMIN_PASSWORD=change-me
# Long random string — encrypts stored passwords + signs admin sessions
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database (optional) ---
# DATABASE_PATH=/app/data/jellyfin.db

# --- Entitlements API (v2.1, server-to-server) ---
# Consumers (e.g. Capstone agent routing) call GET /api/entitlements.
# Set a token to require Authorization: Bearer <token>; empty = open.
ENTITLEMENTS_API_TOKEN=

# --- Cerulean Vault (SecretOps — HashiCorp Vault, KV v2) -------------------
# Values live in Cerulean Vault, and this file may name one with a reference
# (vault://<mount>/<path>#<key>). Nothing in this stack resolves a reference at
# runtime, so .env must hold the resolved value — move plaintext secrets in with
# scripts/vault-migrate.py (see docs/stack.md). The full contract, including the
# path-scoped token file, is in .env.sample.
VAULT_ADDR=
VAULT_TOKEN_FILE=./data/vault/token/magnate.token
VAULT_PREFIX=cerulean
VAULT_PATH=magnate
VAULT_TOKEN=

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) ------------
# Cerulean provisions the public DNS names, NPM proxy hosts, and TLS
# certificates for every Innotel platform, and hosts the Authentik SSO
# (OIDC) identity provider used by the Magnate admin panel.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us
