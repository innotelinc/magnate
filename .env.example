# Public URL of this site (used for Stripe success/cancel redirects)
APP_URL=http://localhost:3000

# --- Stripe ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint you create in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx
# ISO currency code for plan prices (defaults to usd)
STRIPE_CURRENCY=usd

# --- Jellyfin ---
# Your Jellyfin server (no trailing slash)
JELLYFIN_URL=https://media.innotel.us
# Create at Dashboard → Advanced → API Keys
JELLYFIN_API_KEY=your-jellyfin-api-key

# --- jfa-go account portal ---
JFA_GO_URL=https://accounts.innotel.us

# --- Admin panel ---
ADMIN_PASSWORD=change-me
# Long random string — encrypts stored passwords + signs admin sessions
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database (optional) ---
# DATABASE_PATH=/app/data/jellyfin.db

# --- Entitlements API (v2.1, server-to-server) ---
# Consumers (e.g. Capstone agent routing) call GET /api/entitlements.
# Set a token to require Authorization: Bearer <token>; empty = open.
ENTITLEMENTS_API_TOKEN=

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) ------------
# Cerulean provisions the public DNS names, NPM proxy hosts, and TLS
# certificates for every Innotel platform, and hosts the Authentik SSO
# (OIDC) identity provider used by the Magnate admin panel.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us
