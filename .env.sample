# ── Jellyfin Subscription — environment configuration ────────────────────────
# Copy this file to `.env` (gitignored) and fill in real values, then run:
#   docker compose up -d --build
# Compose reads `.env` automatically for the variables in docker-compose.yml.

# Public URL of this site (used for Stripe success/cancel redirects)
APP_URL=https://subscribe.example.com

# Stripe (create keys at https://dashboard.stripe.com/apikeys)
# Use sk_test_… for testing, sk_live_… for production.
STRIPE_SECRET_KEY=sk_test_xxx

# Signing secret from the webhook endpoint in the Stripe dashboard
# (Developers → Webhooks). The endpoint URL must be:
#   <APP_URL>/api/webhook
# Subscribed events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_succeeded, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ISO currency code for plan prices (defaults to usd)
STRIPE_CURRENCY=usd

# Jellyfin server (no trailing slash) + API key
# API key: Dashboard → Advanced → API Keys
JELLYFIN_URL=https://media.example.com
JELLYFIN_API_KEY=your-jellyfin-api-key

# jfa-go account portal (linked from the footer and success page)
JFA_GO_URL=https://accounts.example.com

# Admin panel password (/admin)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Long random string — encrypts stored credentials + signs admin sessions.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override the SQLite database path (default: ./data/jellyfin.db)
# DATABASE_PATH=/app/data/jellyfin.db
