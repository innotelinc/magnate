[TEMPLATE]
# ── Magnate — Subscription Platform · environment configuration ─────────────
# Copy this file to `.env` (gitignored) and fill in real values, then run:
#   ./setup.sh        (full deploy: build + NPM proxy hosts + wildcard SSL)
#   docker compose up -d --build   (app only)
# Compose reads `.env` automatically for the variables in docker-compose.yml.

# ── Public URLs ─────────────────────────────────────────────────────────────
# Storefront (this app). NPM provisions app.magnate.innotel.us for you.
APP_URL=https://app.magnate.innotel.us

# The ARR stack's billing-api (served publicly at api.magnate.innotel.us).
BILLING_API_URL=https://api.magnate.innotel.us

# Stripe (create keys at https://dashboard.stripe.com/apikeys)
# Use sk_test_… for testing, sk_live_… for production.
STRIPE_SECRET_KEY=sk_live_xxx

# Signing secret from the webhook endpoint in the Stripe dashboard
# (Developers → Webhooks). The endpoint URL must be:
#   <APP_URL>/api/webhook
# Subscribed events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_succeeded, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ISO currency code for plan prices (defaults to usd)
STRIPE_CURRENCY=usd

# ── Media & identity ────────────────────────────────────────────────────────
# Jellyfin server (no trailing slash) + API key
# API key: Dashboard → Advanced → API Keys
JELLYFIN_URL=https://media.magnate.innotel.us
JELLYFIN_API_KEY=your-jellyfin-api-key

# Authentik (served publicly at auth.magnate.innotel.us) — accounts and
# passwords live here; Jellyfin authenticates via the LDAP outpost.
AUTHENTIK_BASE_URL=https://auth.magnate.innotel.us
AUTHENTIK_BOOTSTRAP_TOKEN=your-authentik-bootstrap-token

# Account portal link (footer + success page): Authentik self-service user
# settings (password resets). Defaults to AUTHENTIK_BASE_URL/if/user/
ACCOUNT_PORTAL_URL=https://auth.magnate.innotel.us/if/user/

# Jellyseerr movie/TV request portal (Premium perk — linked from the success
# page for Premium purchases only)
REQUEST_URL=https://req.magnate.innotel.us

# ── Affiliate & referral program ────────────────────────────────────────────
# % of a referral's FIRST payment credited to the referrer (0 disables)
REFERRAL_REWARD_PERCENT=10

# Optional Stripe coupon ID (e.g. FRIENDS20) applied to referred signups'
# first invoice. Create it in Stripe → Coupons. Leave empty to skip.
REFERRAL_COUPON_ID=

# ── AI recommendations & churn prevention ───────────────────────────────────
# Any OpenAI-compatible chat-completions endpoint. Leave AI_API_KEY empty to
# disable (the platform works fully without AI).
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── Admin panel ─────────────────────────────────────────────────────────────
# Password for the admin panel (/admin)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Long random string — encrypts stored credentials + signs admin sessions.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override the SQLite database path (default: ./data/magnate.db)
# DATABASE_PATH=/app/data/magnate.db

# ── Nginx Proxy Manager provisioning (used by setup.sh + npm-proxy-hosts.py) ─
# NPM instance (its own hostname/IP, e.g. npm.innotel.us). The API lives at
# /api on the same host: http(s)://<npm-host>/api
NPM_API_URL=https://npm.innotel.us/api
NPM_API_IDENTITY=admin@example.com
NPM_API_SECRET=change-me-npm-password

# Base domain for the subdomains provisioned by npm-proxy-hosts.py:
#   app. api. auth. media. billing. admin. <DOMAIN>
DOMAIN=magnate.innotel.us

# Wildcard Let's Encrypt cert via DNS challenge. NPM must be >= 2.11 for
# dns_challenge. Supported providers follow Certbot's: cloudflare, dnsimple,
# duckdns, hetzner, ovh, etc.
NPM_DNS_PROVIDER=cloudflare

# E-mail used with the DNS provider account (cloudflare/dnsimple/ovh…).
NPM_DNS_EMAIL=admin@example.com

# JSON object of provider credentials (see Certbot dns-plugin docs):
#   cloudflare: {"cloudflare_api_token":"…"} or {"cloudflare_email":"…","cloudflare_api_key":"…"}
#   duckdns:    {"duckdns_token":"…"}
#   hetzner:    {"hetzner_api_token":"…"}
NPM_DNS_CREDENTIALS={"cloudflare_api_token":""}

# Optional: JSON override for the proxy-host map. Defaults provision:
#   app.<DOMAIN>      -> http://127.0.0.1:3000 (this app)
#   api.<DOMAIN>      -> http://127.0.0.1:8000 (billing-api)
#   auth.<DOMAIN>     -> http://127.0.0.1:9000 (Authentik)
#   media.<DOMAIN>    -> http://127.0.0.1:8096 (Jellyfin)
#   billing.<DOMAIN>  -> http://127.0.0.1:3000 (this app, Stripe portal UI)
#   admin.<DOMAIN>    -> http://127.0.0.1:3000 (this app, /admin)
# NPM_HOSTS_JSON=[{"subdomain":"app","forward_host":"127.0.0.1","forward_port":3000},...]